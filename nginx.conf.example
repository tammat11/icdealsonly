# Конфигурация Nginx для ic-group.kz с поддиректорией /deals

server {
    listen 80;
    listen [::]:80;
    server_name ic-group.kz www.ic-group.kz;

    # Редирект на HTTPS (рекомендуется)
    # return 301 https://$server_name$request_uri;

    root /var/www/ic-group.kz;
    index index.html index.htm;

    # Логи
    access_log /var/log/nginx/ic-group.kz-access.log;
    error_log /var/log/nginx/ic-group.kz-error.log;

    # Основной сайт ic-group.kz
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Поддиректория /deals - React SPA
    location /deals {
        alias /var/www/ic-group.kz/deals;
        try_files $uri $uri/ /deals/index.html;
        index index.html;

        # Обработка всех маршрутов React Router
        location ~ ^/deals/(.*)$ {
            try_files $uri $uri/ /deals/index.html;
        }
    }

    # Кэширование статических файлов
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Безопасность
    location ~ /\.(?!well-known) {
        deny all;
    }

    # Gzip сжатие
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/javascript application/json;
}

